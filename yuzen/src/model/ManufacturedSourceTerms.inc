	const double q54 = p.cap*(p.sig0 + q21*(-p.c0s + q15));
	const double q55 = p.gx*p.rho - q12*q50 - q36*(p.ax - x) + q42*(q12 + q41) + q53*q54;
	const double q56 = cos(q37);
	const double q57 = p.SA*q56*sin(q38);
	const double q58 = p.sky*q57;
	const double q59 = pow(p.skx, 2);
	const double q60 = pow(p.kx, 2);
	const double q61 = pow(p.ky, 3)*q25 + pow(p.sky, 3)*q57 + q26*q60 + q58*q59;
	const double q62 = p.gy*p.rho - q26*q50 - q36*(p.ay - y) + q42*(q26 + q58) + q54*q61;
	const double q63 = (1.0/3.0)*q16*pow(q20, 2)*(3*p.lam + q20);
	const double q64 = p.mue*q63;
	const double q65 = q39*q56;
	const double q66 = p.cap*q21;
	const double q67 = q19*q60;
	const double q68 = q59*q65;
	const double q69 = q51*q68 + q52*q67;
	const double q70 = q18*q46;
	const double q71 = pow(q23, 2)*q43;
	const double q72 = p.A*q71;
	const double q73 = q18*q48;
	const double q74 = pow(p.pm, 2)*q45;
	const double q75 = q24*q71;
	const double q76 = pow(p.pn, 2)*q47;
	const double q77 = q4*q43;
	const double q78 = pow(q1, 2)*q77;
	return p.w*q5 + q11*q17*q22 + q11*q55*q64 - pow(q13, 2)*pow(q27, 2)*q34*q35 + q16*q22*q26*q28 - q17*q30*q55 - q26*q31*q62 + q28*q62*q64 - q29*q33 - q29*q35*pow(q7, 2)*pow(q9, 2) - q33*q34 + q63*(-p.P*q60*q77*(q46*q78 - q48*q78 + q70 - q73 + q74*q78 - q76*q78) - q11*q53*q66 + q36 + q42*(q67 + q68) + q54*(pow(p.kx, 4)*q19 + pow(p.skx, 4)*q65 + q69)) + q63*(-q24*q49*q52*(q3*q46 - q3*q48 + q70*q72 - q72*q73 + q74*q75 - q75*q76) - q28*q61*q66 + q36 + q42*(q19*q52 + q51*q65) + q54*(pow(p.ky, 4)*q19 + pow(p.sky, 4)*q65 + q69));
}

inline double MmsConcResidualSlip(const MmsParams &p, double x, double y, double t)
{
	const double q0 = p.cky*y;
	const double q1 = cos(q0);
	const double q2 = p.ckx*x + p.cph - p.cw*t;
	const double q3 = sin(q2);
	const double q4 = p.kx*x - p.w*t;
	const double q5 = cos(q4);
	const double q6 = p.ky*y;
	const double q7 = p.A*cos(q6);
	const double q8 = p.M + q5*q7;
	const double q9 = 1.0/q8;
	const double q10 = cos(q2);
	const double q11 = q1*q10;
	const double q12 = p.CA*q11 + p.CM;
	const double q13 = q7*sin(q4);
	const double q14 = p.kx*q13;
	const double q15 = p.ckx*q1*q3;
	const double q16 = p.A*q5*sin(q6);
	const double q17 = p.ky*q16;
	const double q18 = sin(q0);
	const double q19 = p.cky*q10*q18;
	const double q20 = pow(p.ckx, 2);
	const double q21 = q11*q8;
	const double q22 = pow(p.cky, 2);
	const double q23 = p.CA*p.De*q8;
	const double q24 = p.ms*p.sigc;
	const double q25 = 3*p.CA*q24*(2*p.lam + q8);
	const double q26 = 3*p.lam + q8;
	const double q27 = p.Om2*p.rho;
	const double q28 = p.sky*y;
	const double q29 = p.skx*x;
	const double q30 = p.SA*sin(q29)*cos(q28);
	const double q31 = p.skx*q30;
	const double q32 = p.g*p.rho;
	const double q33 = p.hs*q9;
	const double q34 = p.P*q9*(-p.pm*pow(q33, p.pm) + p.pn*pow(q33, p.pn));
	const double q35 = p.cap*(p.sig0 + q24*(-p.c0s + q12));
	const double q36 = p.SA*sin(q28)*cos(q29);
	const double q37 = p.sky*q36;
	return p.CA*(-p.D0*p.diff*q9*(pow(q1, 2)*q20*q23*pow(q3, 2) + pow(q10, 2)*pow(q18, 2)*q22*q23 + q14*q15 + q17*q19 - q20*q21 - q21*q22)*exp(p.De*(-p.c0D + q12)) - 1.0/6.0*p.conv*(q15*(-q15*q25 + 2*q26*q8*(p.gx*p.rho + q14*q34 + q27*(-p.ax + x) + q32*(q14 + q31) + q35*(pow(p.kx, 3)*q13 + pow(p.ky, 2)*q14 + pow(p.skx, 3)*q30 + pow(p.sky, 2)*q31))) + q19*(-q19*q25 + 2*q26*q8*(p.gy*p.rho + q17*q34 + q27*(-p.ay + y) + q32*(q17 + q37) + q35*(pow(p.kx, 2)*q17 + pow(p.ky, 3)*q16 + pow(p.skx, 2)*q37 + pow(p.sky, 3)*q36))))*exp(-p.mue*(-p.c0m + q12))/p.mu0 + p.cw*q1*q3);
}
